    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Mohsen Khosravi _ mohsen.khosravi@polito.it\n\"\"\"\nDynamo Python Script node - Bowyer-Watson Delaunay triangulation of ONE stratigraphic horizon\n\nINPUTS\n  IN[0] : list of Autodesk.DesignScript.Geometry.Point \n  IN[1] : optional - minimum facet area in model units^2 below which a triangle is treated as\n          degenerate (near-collinear boreholes) and discarded. Default: 1e-6.\n\nOUTPUT  OUT = [triangle_surfaces, tin_polysurface, report]\n  triangle_surfaces : one Surface per Delaunay triangle, through the observed elevations\n  tin_polysurface   : the triangles joined into a single PolySurface (the TIN of the horizon)\n  report            : dictionary with counts and checks (triangles, boundary edges, Euler check,\n                      empty-circumcircle violations, degenerate facets removed, duplicates, run time)\n\nMETHOD\n  1. All tests use the X-Y coordinates only (triangulation in plan).\n  2. Bowyer-Watson incremental insertion inside a super-triangle. A triangle is \"bad\" for the new\n     point p when the in-circle determinant (3x3 form, p translated to the origin, Eq. (6)) is > 0,\n     with the triangle vertices oriented counterclockwise (Eq. (7)). Bad triangles are removed, the\n     cavity boundary is re-triangulated from p, and triangles touching the super-triangle are\n     removed at the end.\n  3. Triangles with area < IN[1] are discarded; every remaining triangle is checked against all\n     points for the empty-circumcircle property.\n  4. Each vertex keeps its observed Z, so every triangle is a planar facet through three observed\n     elevations and all input points (including interior boreholes) are vertices of the TIN.\n  The result does not depend on the order of the input points.\n\"\"\"\nimport math\nimport time\n\ntry:\n    import clr\n    clr.AddReference('ProtoGeometry')\n    from Autodesk.DesignScript.Geometry import Point, Surface, PolySurface\n    IN_DYNAMO = True\nexcept Exception:          \n    IN_DYNAMO = False\n\n\ndef orient(a, b, c):\n    \"\"\"> 0 if a, b, c are counterclockwise, < 0 if clockwise, 0 if collinear.\"\"\"\n    return (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])\n\n\ndef in_circle(a, b, c, p):\n    adx, ady = a[0] - p[0], a[1] - p[1]\n    bdx, bdy = b[0] - p[0], b[1] - p[1]\n    cdx, cdy = c[0] - p[0], c[1] - p[1]\n    ad = adx * adx + ady * ady\n    bd = bdx * bdx + bdy * bdy\n    cd = cdx * cdx + cdy * cdy\n    return (adx * (bdy * cd - bd * cdy)\n            - ady * (bdx * cd - bd * cdx)\n            + ad * (bdx * cdy - bdy * cdx))\n\n\ndef ccw(tri, pts):\n    \"\"\"Return the triangle (i, j, k) with counterclockwise vertex order.\"\"\"\n    i, j, k = tri\n    if orient(pts[i], pts[j], pts[k]) < 0:\n        return (i, k, j)\n    return (i, j, k)\n\n\ndef angular_sort(xy):\n    \"\"\"Return (centre, order): centre = arithmetic mean of X and Y (independent of row order);\n    order = point indices sorted by theta = atan2(dX, dY), i.e. clockwise from the +Y axis.\"\"\"\n    n = float(len(xy))\n    cx = sum(p[0] for p in xy) / n\n    cy = sum(p[1] for p in xy) / n\n    theta = [math.atan2(p[0] - cx, p[1] - cy) for p in xy]          # radians, (-pi, +pi]\n    dist2 = [(p[0] - cx) ** 2 + (p[1] - cy) ** 2 for p in xy]       # tie-break for equal angles\n    order = sorted(range(len(xy)), key=lambda i: (theta[i], dist2[i]))\n    return (cx, cy), order\n\n\n# --------------------------------------------------------------------------------------------\n# Bowyer-Watson Delaunay triangulation\n# --------------------------------------------------------------------------------------------\ndef bowyer_watson(xy, insertion_order=None):\n    n = len(xy)\n    M = 1.0e4                                   # (1) super-triangle (coordinates are O(1))\n    pts = list(xy) + [(-M, -M), (M, -M), (0.0, M)]\n    triangles = set([ccw((n, n + 1, n + 2), pts)])\n\n    for p_i in (insertion_order if insertion_order is not None else range(n)):   # (2) insert points sequentially\n        p = pts[p_i]\n        bad = [t for t in triangles if in_circle(pts[t[0]], pts[t[1]], pts[t[2]], p) > 0]\n        edge_count = {}\n        for t in bad:                           # (3) cavity = union of bad triangles\n            for e in ((t[0], t[1]), (t[1], t[2]), (t[2], t[0])):\n                key = (min(e), max(e))\n                edge_count[key] = edge_count.get(key, 0) + 1\n        for t in bad:\n            triangles.discard(t)\n        for (a, b), cnt in edge_count.items():  # (4) re-triangulate the cavity boundary from p\n            if cnt == 1:\n                triangles.add(ccw((a, b, p_i), pts))\n\n    # remove every triangle that uses a super-triangle vertex\n    return [t for t in triangles if t[0] < n and t[1] < n and t[2] < n]\n\ndef triangulate_horizon(xyz, min_area=1e-6):\n    t0 = time.time()\n    report = {'input_points': len(xyz)}\n\n    # remove duplicated X-Y locations (a horizon must be single-valued in plan)\n    span = max(max(p[0] for p in xyz) - min(p[0] for p in xyz),\n               max(p[1] for p in xyz) - min(p[1] for p in xyz), 1e-9)\n    tol = 1e-9 * span\n    seen, pts, dup = set(), [], []\n    for k, p in enumerate(xyz):\n        key = (round(p[0] / tol), round(p[1] / tol))\n        if key in seen:\n            dup.append(k)\n            continue\n        seen.add(key)\n        pts.append(p)\n    report['duplicate_xy_removed'] = len(dup)\n    report['duplicate_xy_input_indices'] = dup\n    n = len(pts)\n    if n < 3:\n        raise ValueError('At least three points with distinct X-Y locations are required.')\n\n    \n    (cx, cy), order = angular_sort([(p[0], p[1]) for p in pts])\n\n    xs = [((p[0] - cx) / span, (p[1] - cy) / span) for p in pts]\n    tris = bowyer_watson(xs, order)\n\n    # degenerate facets (near-collinear boreholes), area in model units\n    kept, degenerate = [], 0\n    for t in tris:\n        a, b, c = pts[t[0]], pts[t[1]], pts[t[2]]\n        if 0.5 * abs(orient(a, b, c)) < min_area:\n            degenerate += 1\n        else:\n            kept.append(t)\n\n    # empty-circumcircle check of the final triangulation\n    eps = 1e-12\n    violations = 0\n    for t in kept:\n        a, b, c = xs[t[0]], xs[t[1]], xs[t[2]]\n        for i in range(n):\n            if i not in t and in_circle(a, b, c, xs[i]) > eps:\n                violations += 1\n                break\n\n    # boundary edges (used by one triangle only) = vertices of the triangulated domain boundary\n    edge_count = {}\n    for t in kept:\n        for e in ((t[0], t[1]), (t[1], t[2]), (t[2], t[0])):\n            key = (min(e), max(e))\n            edge_count[key] = edge_count.get(key, 0) + 1\n    h = sum(1 for v in edge_count.values() if v == 1)\n\n    report.update({\n        'points_triangulated': n,\n        'reference_centre_xy': [cx, cy],\n        'triangles': len(kept),\n        'boundary_edges': h,\n        'triangles_expected_2n_minus_2_minus_h': 2 * n - 2 - h,\n        'degenerate_facets_removed': degenerate,\n        'empty_circumcircle_violations': violations,\n        'run_time_s': round(time.time() - t0, 4),\n    })\n    return pts, order, kept, report\n\ndef run_horizon(points, min_area):\n    pts, order, tris, report = triangulate_horizon([(p.X, p.Y, p.Z) for p in points], min_area)\n    dyn = [Point.ByCoordinates(p[0], p[1], p[2]) for p in pts]\n    sorted_points = [dyn[i] for i in order]\n    surfaces = [Surface.ByPerimeterPoints([dyn[t[0]], dyn[t[1]], dyn[t[2]]]) for t in tris]\n    tin = PolySurface.ByJoinedSurfaces(surfaces) if surfaces else None\n    return sorted_points, surfaces, tin, report\n\n\nif IN_DYNAMO:\n    data = IN[0]\n    min_area = IN[1] if len(IN) > 1 and IN[1] is not None else 1e-6\n    nested = len(data) > 0 and not hasattr(data[0], 'X')\n    if nested:\n        results = [run_horizon(h, min_area) for h in data]\n        OUT = [list(r) for r in zip(*results)]   \n    else:\n        OUT = list(run_horizon(data, min_area))",
      "Engine": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "bedef53c220b40f3bc746bae87d277df",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "8f30c216face41a6a66893e421ba0b7c",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "65d3ab5391924620ada5c022c9882a92",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5cb24617030d4624951082a399dfe8a2",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "d654225e85694478a997a97357bb5fc2",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "ff74185165104a789f09f2f224d0bc50",
          "Name": "list",
          "Description": "List to flatten.\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
